  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorResponse"
      },
      "LiveStatus": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "LiveStatus"
      },
      "ReadyStatus": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ReadyStatus"
      },
      "StatementEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "transfer_id": {
            "type": "integer",
            "title": "Transfer Id"
          },
          "direction": {
            "type": "string",
            "enum": [
              "debit",
              "credit"
            ],
            "title": "Direction"
          },
          "amount": {
            "type": "integer",
            "title": "Amount"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "transfer_id",
          "direction",
          "amount",
          "type",
          "note",
          "created_at"
        ],
        "title": "StatementEntry"
      },
      "StatementResponse": {
        "properties": {
          "wallet_id": {
            "type": "integer",
            "title": "Wallet Id"
          },
          "currency": {
            "type": "string",
            "const": "INR",
            "title": "Currency"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/StatementEntry"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "wallet_id",
          "currency",
          "limit",
          "offset",
          "items"
        ],
        "title": "StatementResponse"
      },
      "UserCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{7,14}$",
            "title": "Phone"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "phone"
        ],
        "title": "UserCreate",
        "example": {
          "email": "nila@example.test",
          "name": "Nila",
          "phone": "+919123456780"
        }
      },
      "UserCreated": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "kyc_status": {
            "type": "string",
            "title": "Kyc Status"
          },
          "token": {
            "type": "string",
            "title": "Token",
            "description": "Shown once. Store securely; only its hash is persisted."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "kyc_status",
          "token"
        ],
        "title": "UserCreated"
      },
      "WalletCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "WalletCreate",
        "example": {
          "name": "Main"
        }
      },
      "WalletList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WalletResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "WalletList"
      },
      "WalletResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "currency": {
            "type": "string",
            "const": "INR",
            "title": "Currency"
          },
          "balance": {
            "type": "integer",
            "title": "Balance"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "name",
          "currency",
          "balance"
        ],
        "title": "WalletResponse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Health",
      "description": "Application liveness and database readiness."
    },
    {
      "name": "Users",
