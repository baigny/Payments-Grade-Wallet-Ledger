# Development values only. Copy to .env to override locally.
POSTGRES_DB=wallet
POSTGRES_USER=wallet_owner
POSTGRES_PASSWORD=local-wallet-password
POSTGRES_PORT=55432
API_PORT=8000
WALLET_APP_PASSWORD=local-app-password
RECONCILIATION_ENABLED=true
RECONCILIATION_UTC_HOUR=2
RECONCILIATION_UTC_MINUTE=0
RECONCILIATION_STATEMENT_TIMEOUT_MS=300000
LLM_PROVIDER=mock
# Set LLM_PROVIDER=hosted to enable this endpoint; mock never makes model calls.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
EXPLANATION_BATCH_SIZE=1
