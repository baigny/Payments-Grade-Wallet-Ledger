    {
      "name": "Reverse Transfer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{base_url}}/transfers/{{transfer_id}}/reversal",
        "description": "Admin posts one full reversal. The original and its entries remain immutable.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}"
            }
          ]
        }
      },
