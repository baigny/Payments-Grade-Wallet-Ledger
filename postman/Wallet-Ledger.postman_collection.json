        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"peer\",\n  \"source_account_id\": {{wallet_id}},\n  \"amount\": 1000,\n  \"destination_account_id\": {{recipient_wallet_id}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Saved status\", () => pm.response.to.have.status(201));",
              "pm.test(\"Exact saved body\", () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get(\"peer_response\")));",
              "pm.test(\"Replay header\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replay\")).to.eql(\"true\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject changed amount with the same key",
