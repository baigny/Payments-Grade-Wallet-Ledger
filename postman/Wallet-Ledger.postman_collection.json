        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"peer\",\n  \"source_account_id\": {{wallet_id}},\n  \"amount\": 2000,\n  \"destination_account_id\": {{recipient_wallet_id}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Conflict status\", () => pm.response.to.have.status(422));",
              "pm.test(\"Key reuse rejected\", () => pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_KEY_REUSED\"));"
            ]
          }
        }
      ]
    },
