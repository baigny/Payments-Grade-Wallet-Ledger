{
  "info": {
    "name": "Wallet Ledger",
    "description": "Bootstrap an admin and set admin_token before running. Requests create a user and wallet, then exercise implemented endpoints. Every POST uses a fresh UUID; replay protection is milestone 3. Returned tokens stay local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "wallet_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "transfer_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Check application liveness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/health/live",
        "description": "Check application liveness"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Request ID\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\"))",
              "    .to.be.a(\"string\").and.not.empty);",
              "pm.test(\"Health status\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Check database and schema readiness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/health/ready",
        "description": "Check database and schema readiness"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Request ID\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\"))",
              "    .to.be.a(\"string\").and.not.empty);",
              "pm.test(\"Health status\", () => pm.expect(pm.response.json().status).to.eql(\"ready\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users",
        "description": "Admin creates a user and receives a one-time bearer token.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{new_email}}\",\n  \"name\": \"Nila\",\n  \"phone\": \"{{new_phone}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"new_email\", pm.variables.replaceIn(\"{{$guid}}\") + \"@example.test\");",
              "pm.collectionVariables.set(\"new_phone\", \"+919\" + Date.now().toString().slice(-9));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(201));",
              "pm.test(\"Request ID\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\"))",
              "    .to.be.a(\"string\").and.not.empty);",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"user_id\", pm.response.json().id);",
              "    pm.collectionVariables.set(\"user_token\", pm.response.json().token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Wallet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users/{{user_id}}/wallets",
        "description": "Create an empty INR wallet for the caller, or for any user as an admin.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Main\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(201));",
              "pm.test(\"Request ID\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\"))",
              "    .to.be.a(\"string\").and.not.empty);",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"wallet_id\", pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List Wallets",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users/{{user_id}}/wallets",
        "description": "List Wallets",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Request ID\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\"))",
              "    .to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "Balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/wallets/{{wallet_id}}/balance",
        "description": "Balance",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Request ID\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\"))",
              "    .to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "Statement",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/wallets/{{wallet_id}}/statement",
        "description": "Statement",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Request ID\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\"))",
              "    .to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ]
    }
  ]
}
